 parameter DMA_LEN_WIDTH = 16;
-parameter DMA_TAG_WIDTH = 8;
+// 16 bits (was 8): bit 8 is the AT chicken bit, see dma_if_pcie_rd.v
+parameter DMA_TAG_WIDTH = 16;
 
 parameter IRQ_INDEX_WIDTH = 5;
 
